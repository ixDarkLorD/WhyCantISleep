{
  "schemaVersion": 1,
  "id": "${modid}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_page_url}",
    "issues": "${mod_issue_url}",
    "sources": "${mod_source_url}"
  },

  "license": "${mod_license}",

  "environment": "${mod_environment}",
  "entrypoints": {
    "coolcatlib:common": [
      "net.ixdarklord.whycantisleep.WhyCantISleep"
    ],
    "coolcatlib:client": [
      "net.ixdarklord.whycantisleep.WhyCantISleepClient"
    ],
    "voicechat": [
      "net.ixdarklord.whycantisleep.compat.voicechat.WCISVoicechatPlugin"
    ]
  },
  "mixins": [
    "${modid}.common.mixins.json"
  ],

  "custom": {
    "glazedmenu": {
      "update_json": "${mod_fabric_update_url}"
    }
  },

  "depends": {
    "java": ">=${versions.java.get()}",
    "minecraft": ">=${project.supported_min_mc_version} <=${max_mc_version}",
    "fabricloader": ">=${min_fabric_version}",
    "fabric-api": ">=${project.supported_min_fabric_api_version}",
    "coolcatlib": ">=${coolcatlib_min_version}",
    "folios": ">=${folios_min_version}"
  },
  "suggests": {
    "voicechat": "*"
  }
}
